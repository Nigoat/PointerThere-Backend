# PointerThere — C++ Backend Environment Variables
# Copy to .env and fill in your values

# ─── Server ───────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ─── Database (Neon PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/pointerthere?sslmode=require

# ─── JWT & Auth ───────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_64_char_secret_for_tokens
ADMIN_USERNAME=Nigoattt
ADMIN_PASSWORD=XYZ123LMBLABLA1983
ADMIN_SESSION_SECRET=change_me_to_random_admin_session_secret

# ─── Cloudflare Turnstile ──────────────────────────────────
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=noreply@pointerthere.com

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
API_KEY_MONTHLY_LIMIT=100000
